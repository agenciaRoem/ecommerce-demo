{
	email {$ACME_EMAIL}

	servers {
		# Solo se confía en los encabezados de IP que llegan desde Cloudflare. Cualquier otro origen no puede
		# falsear su IP: Caddy la reescribe con la real, y de ahí sale el límite de tasa y la auditoría.
		# Lista oficial: https://www.cloudflare.com/ips/ (revisarla de vez en cuando).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(seguridad) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
}

# Tienda (Next.js)
{$APP_DOMAIN} {
	import seguridad
	reverse_proxy frontend:3000
}

# API (NestJS). Las fotos de productos se sirven desde acá (/media).
api.{$APP_DOMAIN} {
	import seguridad
	request_body {
		max_size 12MB
	}
	reverse_proxy backend:4000
}
