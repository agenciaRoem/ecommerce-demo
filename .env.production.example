# Plantilla para el .env del servidor de producción. Copiar a `.env` y completar TODO.
# Generar secretos:  openssl rand -base64 48   (y para la clave de cifrado: openssl rand -base64 32)

# ── Dominio ──
APP_DOMAIN=tienda.com.ar
ACME_EMAIL=admin@tienda.com.ar
PUBLIC_STORE_URL=https://tienda.com.ar
PUBLIC_API_URL=https://api.tienda.com.ar
MEDIA_PUBLIC_URL=https://api.tienda.com.ar/media
CORS_ORIGINS=https://tienda.com.ar
COOKIE_SECURE=true
# Dominio común para las cookies (tienda y API son subdominios del mismo sitio).
# COOKIE_DOMAIN=tienda.com.ar

# ── Imágenes (las publica el pipeline en GHCR) ──
REGISTRY=ghcr.io/su-usuario
IMAGE_TAG=latest

# ── Base de datos y Redis (no se publican fuera del servidor) ──
POSTGRES_USER=omnistock
POSTGRES_PASSWORD=
POSTGRES_DB=omnistock
REDIS_PASSWORD=

# ── Secretos de la aplicación ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Si se pierde, las credenciales de Mercado Pago guardadas no se pueden recuperar. Guardar una copia fuera del servidor.
SETTINGS_ENCRYPTION_KEY=

# ── Primer superadmin (solo para el primer arranque; después se pueden quitar) ──
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_CATALOG=false

# ── Negocio ──
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
ORDER_PAYMENT_WINDOW_MINUTES=30

# ── Correo: obligatorio. Sin esto nadie puede confirmar su email ni recuperar su contraseña ──
MAIL_DRIVER=smtp
MAIL_FROM="Mi Papelería <no-responder@tienda.com.ar>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
STORE_NAME=Mi Papelería
# Con el dominio del remitente configurado en el proveedor (SPF y DKIM) para que los correos no caigan en spam.

# ── Ingreso con Google (opcional; dejar vacío para no mostrar el botón) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
