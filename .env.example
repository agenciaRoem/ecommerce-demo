# Copiar a .env y completar. NUNCA subir .env al repositorio.
POSTGRES_USER=omnistock
POSTGRES_PASSWORD=cambiar-por-un-secreto-largo
POSTGRES_DB=omnistock
REDIS_PASSWORD=cambiar-por-otro-secreto-largo

# Para ejecutar el backend fuera de Docker (npm run start:dev en /backend)
DATABASE_URL=postgresql://omnistock:cambiar-por-un-secreto-largo@localhost:5432/omnistock
REDIS_URL=redis://:cambiar-por-otro-secreto-largo@localhost:6379

# Seed del primer SUPERADMIN (mínimo 12 caracteres)
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=

# Autenticación (secretos distintos, mínimo 32 caracteres: `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# En producción con HTTPS dejar en true (por defecto true si NODE_ENV=production)
COOKIE_SECURE=false

# Imágenes (driver local: se guardan en un volumen y se sirven desde /media)
MEDIA_PUBLIC_URL=http://localhost:4000/media
# Márgenes para calcular precios iniciales a partir del costo (opcionales)
# DEFAULT_RETAIL_MARGIN_PERCENT=50
# DEFAULT_WHOLESALE_MARGIN_PERCENT=25

# SOLO desarrollo: crea gerente/sala/stockeo de ejemplo (mínimo 12 caracteres). Dejar vacío en producción.
SEED_DEMO_STAFF_PASSWORD=
# SOLO desarrollo: carga un catálogo de ejemplo (productos, imágenes, stock y promociones).
SEED_DEMO_CATALOG=false

# ───────── Pagos (Mercado Pago) ─────────
# Las credenciales de Mercado Pago NO van acá: las carga el superadmin desde el backoffice (/admin/pagos).
# Esta clave cifra esas credenciales en la base. Generala con `openssl rand -base64 32`, guardala en un
# gestor de contraseñas y no la cambies: si se pierde hay que volver a cargar las credenciales.
SETTINGS_ENCRYPTION_KEY=
# URLs públicas (HTTPS en producción). Mercado Pago llama al webhook en PUBLIC_API_URL y devuelve al cliente a PUBLIC_STORE_URL.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_STORE_URL=http://localhost:3000

# Pedidos: minutos para pagar antes de que se libere el stock reservado, y cada cuántos segundos se revisan los vencidos.
# Cuántos proxies hay delante del backend (Caddy = 1). Solo así la IP del cliente es la real. En desarrollo: 0.
# TRUST_PROXY=0

# Zona horaria del negocio (qué es "hoy" en las métricas del backoffice).
# BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# ORDER_PAYMENT_WINDOW_MINUTES=30
# ORDER_EXPIRY_INTERVAL_SECONDS=60

# ── Correo (verificación de email y recuperación de contraseña) ──
# En desarrollo no hace falta nada: con MAIL_DRIVER=log el correo no se envía y su contenido (con el enlace)
# aparece en el log:  docker compose logs -f backend
# MAIL_DRIVER=log
# En producción hay que usar smtp (Brevo, Mailgun, Amazon SES, Gmail con contraseña de aplicación…):
# MAIL_DRIVER=smtp
# MAIL_FROM="Mi Papelería <no-responder@tu-dominio.com>"
# SMTP_HOST=smtp.proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false   # true solo para el puerto 465
# SMTP_USER=
# SMTP_PASS=
# STORE_NAME=Mi Papelería
# Si es false, se puede comprar sin confirmar el email (no recomendado).
# REQUIRE_VERIFIED_EMAIL=true

# ── Ingreso con Google (opcional) ──
# Crear un "ID de cliente OAuth" (aplicación web) en console.cloud.google.com → APIs y servicios → Credenciales,
# con esta URI de redirección autorizada:  <PUBLIC_API_URL>/customers/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
